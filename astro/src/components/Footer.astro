---
import homeData from '../data/homepage-content.json';
const footer = homeData.footer;

const currentYear = new Date().getFullYear();
const copyrightText = (footer?.bottom_bar?.copyright || '© {{year}} Autodiagnostix. All rights reserved.').replace('{{year}}', String(currentYear));

const socialIcons: Record<string, string> = {
  Facebook: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z"/></svg>',
  LinkedIn: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 5a2 2 0 1 1-4-.002 2 2 0 0 1 4 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.02-1.68z"/></svg>',
  Instagram: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
};
---

<footer class="bg-zinc-50 border-t border-zinc-200">
  <div class="footer-grid grid grid-cols-2 gap-x-8 gap-y-10 w-full px-8 py-12 md:py-16 max-w-site mx-auto">
    <div class="col-span-2 lg:col-span-1">
      <a href="/" class="mb-4 inline-flex items-center min-h-[44px]" aria-label="Autodiagnostix home">
        <picture>
          <source srcset="/logo-wordmark.avif" type="image/avif" />
          <img src="/logo-wordmark.webp" alt={footer?.company_info?.name || 'Autodiagnostix'} width="400" height="82" loading="lazy" decoding="async" class="h-8 w-auto" />
        </picture>
      </a>
      <p class="text-zinc-600 text-sm leading-relaxed max-w-sm mb-5">
        {footer?.company_info?.description || 'Your trusted partner for professional automotive diagnostic equipment in Pakistan.'}
      </p>
      <div class="flex gap-1 -ml-3">
        {(footer?.company_info?.social_icons || []).map(icon => (
          <a
            href={icon.href || '#'}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${icon.name} (opens in a new tab)`}
            class="text-zinc-500 hover:text-primary flex items-center justify-center w-11 h-11 rounded-full hover:bg-zinc-100 transition-colors"
          >
            <span set:html={socialIcons[icon.name] || ''} aria-hidden="true" class="flex"></span>
          </a>
        ))}
      </div>
    </div>

    {(footer?.menu_columns || []).map(col => {
      const wide = (col.links || []).length > 6;
      return (
        <div class={wide ? 'col-span-2 lg:col-span-1' : ''}>
          <p class="uppercase text-xs font-bold tracking-widest text-zinc-600 mb-3 md:mb-4">{col.title}</p>
          <ul class={wide ? 'sm:columns-2 md:columns-3 lg:columns-2 gap-x-8' : ''}>
            {(col.links || []).map(link => (
              <li class="break-inside-avoid">
                <a href={link.href || '#'} class="footer-link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}

    {/* Newsletter hidden per request */}
  </div>

  <div class="w-full px-8 py-6 border-t border-zinc-200 max-w-site mx-auto flex flex-col md:flex-row justify-between items-center gap-3">
    <span class="text-zinc-600 text-[11px] uppercase tracking-widest text-center">{copyrightText}</span>
    <div class="flex flex-wrap justify-center gap-x-6 gap-y-0">
      <a href="/privacy-policy" class="footer-meta-link">Privacy Policy</a>
      <a href="/terms-of-service" class="footer-meta-link">Terms of Service</a>
      {(footer?.bottom_bar?.social_links || []).map(link => (
        <a
          href={link.href || '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="footer-meta-link"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  /* Company blurb, two short link columns and a wider "Popular" column that
     flows into sub-columns, so no column runs far longer than the others. */
  @media (min-width: 64rem) {
    .footer-grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr); }
  }
  .footer-link {
    display: inline-flex; align-items: center; min-height: 44px; min-width: 44px;
    font-size: 0.875rem; color: #52525b; transition: color 150ms ease-out;
  }
  .footer-link:hover { color: #97000d; }
  @media (min-width: 48rem) { .footer-link { min-height: 36px; } }
  .footer-meta-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #52525b; transition: color 150ms ease-out;
  }
  .footer-meta-link:hover { color: #18181b; }
</style>
