---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbListSchema, organizationSchema } from '../utils/schema';
import { SUBJECTS } from '../lib/contact.mjs';

export const prerender = false;

const breadcrumbs = [
  { name: 'Home', url: 'https://autodiagnostix.com.pk/' },
  { name: 'Contact', url: 'https://autodiagnostix.com.pk/contact' },
];


// "Request a Quote" links from product pages pass ?subject=quote&product=Name.
const requestedSubject = Astro.url.searchParams.get('subject') || '';
const prefillSubject = SUBJECTS.some(([value]) => value === requestedSubject) ? requestedSubject : '';
const requestedProduct = (Astro.url.searchParams.get('product') || '').replace(/[\r\n]+/g, ' ').trim().slice(0, 120);
const prefillMessage = requestedProduct ? `I would like a quote for: ${requestedProduct}\n\n` : '';
---

<BaseLayout
  title="Contact Autodiagnostix: Workshop Equipment Quotes Across Pakistan"
  description="Get in touch with Autodiagnostix, Pakistan's authorized dealer for LAUNCH, SMARTSAFE, UNITE, Liberty Lifts, GTI.tools, and AUTOOL. Request a quote for car lifts, wheel aligners, diagnostic scanners, ADAS, EV diagnostic tools and workshop equipment. Delivery across Pakistan."
  canonical="https://autodiagnostix.com.pk/contact"
  jsonLd={[breadcrumbListSchema(breadcrumbs), organizationSchema()]}
>
  <Header ctaLabel="Request a Quote" ctaHref="/contact" />

  <main id="main-content" class="min-h-screen pt-14 md:pt-16">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-surface pt-20 pb-24 px-8">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-primary/10" />
      <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-primary/8 via-transparent to-transparent" />
      <div class="relative max-w-screen-2xl mx-auto">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-xs font-label uppercase tracking-widest text-on-surface-variant mb-8" aria-label="Breadcrumb">
          <a href="/" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Home</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">Contact</span>
        </nav>
        <div class="max-w-3xl">
          <h1 class="font-headline text-5xl md:text-7xl font-extrabold tracking-tighter text-on-surface mb-6 leading-[1.08]">
            Get in <span class="text-primary">Touch</span>
          </h1>
          <p class="text-on-surface-variant text-xl md:text-2xl leading-relaxed max-w-2xl">
            Have a question about our products or need a personalized quote? Our team is ready to help.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Info -->
    <section class="relative -mt-12 px-8 pb-20" aria-label="Contact information">
      <div class="max-w-screen-2xl mx-auto">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 md:gap-6">
          <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm border border-outline-variant/20 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="material-symbols-outlined text-3xl text-primary mb-4" aria-hidden="true">location_on</span>
            <h2 class="font-headline font-bold text-lg text-on-surface mb-2">Address</h2>
            <p class="text-sm text-on-surface-variant leading-relaxed">
              Shalimar Town, Main Bypass Road<br />
              Sahiwal, Punjab<br />
              Pakistan
            </p>
          </div>
          <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm border border-outline-variant/20 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="material-symbols-outlined text-3xl text-primary mb-4" aria-hidden="true">call</span>
            <h2 class="font-headline font-bold text-lg text-on-surface mb-2">Phone</h2>
            <a href="tel:+923227041953" class="flex items-center min-h-[44px] text-sm text-on-surface-variant hover:text-primary transition-colors">+92 322 7041953</a>
            <a href="tel:+923005399757" class="flex items-center min-h-[44px] text-sm text-on-surface-variant hover:text-primary transition-colors">+92 300 5399757</a>
            <a href="tel:+923055851888" class="flex items-center min-h-[44px] text-sm text-on-surface-variant hover:text-primary transition-colors">+92 305 5851888</a>
          </div>
          <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm border border-outline-variant/20 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="material-symbols-outlined text-3xl text-primary mb-4" aria-hidden="true">mail</span>
            <h2 class="font-headline font-bold text-lg text-on-surface mb-2">Email</h2>
            <a href="mailto:info@autodiagnostix.com.pk" class="flex items-center min-h-[44px] text-sm text-on-surface-variant hover:text-primary transition-colors">info@autodiagnostix.com.pk</a>
            <a href="mailto:sales@autodiagnostix.com.pk" class="flex items-center min-h-[44px] text-sm text-on-surface-variant hover:text-primary transition-colors">sales@autodiagnostix.com.pk</a>
          </div>
          <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm border border-outline-variant/20 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300">
            <span class="material-symbols-outlined text-3xl text-primary mb-4" aria-hidden="true">schedule</span>
            <h2 class="font-headline font-bold text-lg text-on-surface mb-2">Business Hours</h2>
            <div class="space-y-1 text-sm text-on-surface-variant">
              <div class="flex justify-between"><span>Sat – Thu</span><span class="font-medium text-on-surface">9:00 – 18:00</span></div>
              <div class="flex justify-between"><span>Friday</span><span class="font-medium text-primary font-bold">Closed</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form + Map -->
    <section class="py-20 px-8 bg-surface-container-low">
      <div class="max-w-screen-2xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
          <!-- Form -->
          <div class="lg:col-span-3">
            <span class="text-xs font-label uppercase tracking-widest text-primary font-bold mb-3 block">Send a Message</span>
            <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-8">
            Let's Start a Conversation
            </h2>
            <form id="contact-form" action="mailto:info@autodiagnostix.com.pk" method="post" enctype="text/plain" class="bg-surface-container-lowest rounded-xl p-6 sm:p-8 md:p-10 shadow-sm border border-outline-variant/20" data-to="info@autodiagnostix.com.pk" data-cc="sales@autodiagnostix.com.pk">
              <div id="form-error-summary" role="alert" class="hidden mb-6 rounded-lg border border-error/30 bg-error-container/40 px-4 py-3 text-sm text-on-error-container" tabindex="-1"></div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mb-2">Full Name <span class="text-primary" aria-hidden="true">*</span></label>
                  <input type="text" id="name" name="name" autocomplete="name" required maxlength="120" aria-describedby="name-error"
                    class="w-full px-4 py-3 min-h-[48px] bg-surface rounded-lg border border-outline text-on-surface placeholder:text-on-surface-variant/70 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors aria-[invalid=true]:border-error aria-[invalid=true]:ring-error/20"
                    placeholder="John Doe" />
                  <p id="name-error" class="field-error mt-2 text-sm text-error" hidden></p>
                </div>
                <div>
                  <label for="email" class="block text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mb-2">Email Address <span class="text-primary" aria-hidden="true">*</span></label>
                  <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required maxlength="160" aria-describedby="email-error"
                    class="w-full px-4 py-3 min-h-[48px] bg-surface rounded-lg border border-outline text-on-surface placeholder:text-on-surface-variant/70 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors aria-[invalid=true]:border-error aria-[invalid=true]:ring-error/20"
                    placeholder="john@example.com" />
                  <p id="email-error" class="field-error mt-2 text-sm text-error" hidden></p>
                </div>
                <div>
                  <label for="phone" class="block text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mb-2">Phone Number</label>
                  <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel" maxlength="24" aria-describedby="phone-error"
                    class="w-full px-4 py-3 min-h-[48px] bg-surface rounded-lg border border-outline text-on-surface placeholder:text-on-surface-variant/70 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors aria-[invalid=true]:border-error aria-[invalid=true]:ring-error/20"
                    placeholder="+92 3XX XXXXXXX" />
                  <p id="phone-error" class="field-error mt-2 text-sm text-error" hidden></p>
                </div>
                <div>
                  <label for="subject" class="block text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mb-2">Subject <span class="text-primary" aria-hidden="true">*</span></label>
                  <select id="subject" name="subject" required aria-describedby="subject-error"
                    class="w-full px-4 py-3 min-h-[48px] bg-surface rounded-lg border border-outline text-on-surface placeholder:text-on-surface-variant/70 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors aria-[invalid=true]:border-error aria-[invalid=true]:ring-error/20">
                    <option value="" disabled selected={!prefillSubject}>Select a topic</option>
                    {SUBJECTS.map(([value, text]) => <option value={value} selected={prefillSubject === value}>{text}</option>)}
                  </select>
                  <p id="subject-error" class="field-error mt-2 text-sm text-error" hidden></p>
                </div>
              </div>
              <div class="mt-6">
                <label for="message" class="block text-xs font-label uppercase tracking-widest text-on-surface-variant font-bold mb-2">Message <span class="text-primary" aria-hidden="true">*</span></label>
                <textarea id="message" name="message" required rows="5" minlength="10" maxlength="3000" aria-describedby="message-error"
                  class="w-full px-4 py-3 min-h-[48px] bg-surface rounded-lg border border-outline text-on-surface placeholder:text-on-surface-variant/70 text-base focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors aria-[invalid=true]:border-error aria-[invalid=true]:ring-error/20 resize-y"
                  placeholder="Tell us about your requirements...">{prefillMessage}</textarea>
                <p id="message-error" class="field-error mt-2 text-sm text-error" hidden></p>
              </div>
              <div class="hp-field" aria-hidden="true">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <p class="mt-3 text-xs text-on-surface-variant">Fields marked with <span class="text-primary" aria-hidden="true">*</span> are required.</p>
              <button type="submit" id="contact-submit"
                class="primary-gradient text-white font-headline font-bold text-xs uppercase tracking-widest px-10 min-h-[48px] w-full sm:w-auto rounded-lg hover:scale-[0.98] transition-all duration-200 cursor-pointer mt-6">
                Send Message
              </button>
            </form>
            <div id="contact-sent" class="hidden bg-surface-container-lowest rounded-xl p-6 sm:p-8 md:p-10 shadow-sm border border-outline-variant/20" role="status" tabindex="-1">
              <h3 class="font-headline text-2xl font-extrabold tracking-tight text-on-surface mb-3">Thank you, your message has been sent</h3>
              <p class="text-on-surface-variant leading-relaxed mb-6">Our team has received your enquiry and will contact you using the details you provided. For anything urgent, please call us during business hours.</p>
              <div class="flex flex-col sm:flex-row flex-wrap gap-3">
                <a href="tel:+923227041953" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-lg primary-gradient text-white font-headline font-bold text-xs uppercase tracking-widest">Call +92 322 7041953</a>
                <a href="/products" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-lg border border-primary text-primary font-headline font-bold text-xs uppercase tracking-widest hover:bg-primary/5 transition-colors">Browse products</a>
              </div>
            </div>
            <div id="contact-success" class="hidden bg-surface-container-lowest rounded-xl p-6 sm:p-8 md:p-10 shadow-sm border border-outline-variant/20" role="status" tabindex="-1">
              <h3 class="font-headline text-2xl font-extrabold tracking-tight text-on-surface mb-3">Your message is ready to send</h3>
              <p class="text-on-surface-variant leading-relaxed mb-6">We opened your email app with your message addressed to our team. Press <strong>Send</strong> there to deliver it. If no email app opened, copy the message and email it to <a href="mailto:info@autodiagnostix.com.pk" class="text-primary underline underline-offset-2">info@autodiagnostix.com.pk</a>, or call us.</p>
              <div class="flex flex-col sm:flex-row flex-wrap gap-3">
                <button type="button" id="contact-copy" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-lg border border-primary text-primary font-headline font-bold text-xs uppercase tracking-widest hover:bg-primary/5 transition-colors">Copy message</button>
                <a href="tel:+923227041953" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-lg primary-gradient text-white font-headline font-bold text-xs uppercase tracking-widest">Call +92 322 7041953</a>
                <button type="button" id="contact-reset" class="inline-flex items-center justify-center min-h-[48px] px-6 rounded-lg text-on-surface-variant font-headline font-bold text-xs uppercase tracking-widest hover:text-primary transition-colors">Edit message</button>
              </div>
              <p id="contact-copy-status" class="mt-3 text-sm text-on-surface-variant" aria-live="polite"></p>
            </div>
          </div>

          <!-- Map -->
          <div class="lg:col-span-2">
            <span class="text-xs font-label uppercase tracking-widest text-primary font-bold mb-3 block">Visit Us</span>
            <h2 class="font-headline text-3xl md:text-4xl font-extrabold tracking-tighter text-on-surface mb-8">
              Our Location
            </h2>
            <a href="https://maps.app.goo.gl/CcdaixKZ7UpDFh9p9" target="_blank" rel="noopener noreferrer" class="block bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm border border-outline-variant/20 hover:shadow-lg hover:border-primary/30 transition-all group">
              <div class="aspect-[4/3] bg-surface-container-high flex items-center justify-center text-on-surface-variant relative overflow-hidden">
                <div class="absolute inset-0 bg-[length:40px_40px] opacity-[0.03]" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px);"></div>
                <div class="text-center p-8 relative z-10">
                  <span class="material-symbols-outlined text-5xl text-primary/40 mb-4 block" aria-hidden="true">map</span>
                  <p class="text-sm font-medium group-hover:text-primary transition-colors">Open in Google Maps</p>
                  <p class="text-xs mt-2 text-on-surface-variant/70">Shalimar Town, Main Bypass Road, Sahiwal</p>
                  <div class="mt-4 text-xs text-on-surface-variant/50 font-mono">30.6644° N / 73.1085° E</div>
                </div>
              </div>
            </a>
            <div class="mt-4 flex items-start gap-3 bg-primary/5 border border-primary/10 rounded-lg p-4">
              <span class="material-symbols-outlined text-primary text-sm mt-0.5" aria-hidden="true">info</span>
              <p class="text-xs text-on-surface-variant leading-relaxed">Prefer speaking with someone directly? Call our technical desk for immediate assistance during business hours.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="on-dark relative overflow-hidden py-24 px-8">
      <div class="absolute inset-0 bg-gradient-to-br from-primary via-[#a50a18] to-[#7d000b]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.12),transparent_50%)]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_left,rgba(255,255,255,0.06),transparent_40%)]" />
      <div class="relative max-w-3xl mx-auto text-center">
        <span class="text-xs font-label uppercase tracking-widest text-white/85 font-bold mb-4 block">Need Immediate Assistance?</span>
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tighter text-white mb-6 leading-[1.08]">
          Call Our Technical Desk
        </h2>
        <p class="text-white/80 text-lg mb-10 max-w-lg mx-auto leading-relaxed">
          Our team is available during business hours to answer your questions and provide expert guidance.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+923227041953"
            class="inline-flex items-center gap-2 bg-white text-primary font-extrabold px-10 py-4 text-sm uppercase tracking-widest rounded-lg hover:bg-white/90 hover:scale-[0.97] transition-all duration-200">
            <span class="material-symbols-outlined text-base" aria-hidden="true">call</span>
            +92 322 7041953
          </a>
          <a href="mailto:info@autodiagnostix.com.pk"
            class="inline-flex items-center gap-2 border border-white/40 text-white px-10 py-4 text-sm uppercase tracking-widest rounded-lg hover:bg-white/10 hover:scale-[0.97] transition-all duration-200">
            <span class="material-symbols-outlined text-base" aria-hidden="true">mail</span>
            Email Us
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  // Progressive enhancement. With JavaScript the form validates inline and
  // posts to /api/contact. If server delivery is not configured (501) or
  // fails, the message is handed to the visitor's mail app instead, so an
  // enquiry is never silently dropped. Without JavaScript the form's mailto:
  // action opens the mail app directly.
  import { RULES, composeMessage, subjectLabel } from '../lib/contact.mjs';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const sent = document.getElementById('contact-sent');
  const success = document.getElementById('contact-success');
  const summary = document.getElementById('form-error-summary');
  const submit = document.getElementById('contact-submit') as HTMLButtonElement | null;
  if (form && sent && success && summary && submit) {
    form.noValidate = true;
    const rules = RULES as Record<string, (value: string) => string>;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const showError = (name: string, message: string) => {
      const input = field(name);
      const error = document.getElementById(`${name}-error`);
      input.setAttribute('aria-invalid', String(Boolean(message)));
      if (error) { error.textContent = message; error.hidden = !message; }
      return message;
    };
    const validate = (name: string) => showError(name, rules[name](field(name).value.trim()));
    const showSummary = (text: string, focusName?: string) => {
      summary.textContent = text;
      summary.classList.remove('hidden');
      if (focusName) field(focusName).focus(); else summary.focus();
    };
    Object.keys(rules).forEach(name => {
      const input = field(name);
      // Validate on leaving a field, then live once the visitor has seen an error.
      input.addEventListener('blur', () => { if (input.value.trim() || input.getAttribute('aria-invalid')) validate(name); });
      input.addEventListener('input', () => { if (input.getAttribute('aria-invalid') === 'true') validate(name); });
      input.addEventListener('change', () => { if (input.getAttribute('aria-invalid') === 'true') validate(name); });
    });

    let composed = '';
    const values = () => Object.fromEntries(Object.keys(rules).map(name => [name, field(name).value.trim()]));
    const openMailApp = (data: Record<string, string>) => {
      const params = new URLSearchParams({ cc: form.dataset.cc || '', subject: `${subjectLabel(data.subject)}: ${data.name}`, body: composed });
      window.location.href = `mailto:${form.dataset.to}?${params.toString().replace(/\+/g, '%20')}`;
      form.classList.add('hidden');
      success.classList.remove('hidden');
      success.focus();
    };

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (submit.disabled) return;
      const errors = Object.keys(rules).map(name => [name, validate(name)]).filter(([, message]) => message);
      if (errors.length) {
        showSummary(errors.length === 1 ? 'Please fix the highlighted field.' : `Please fix the ${errors.length} highlighted fields.`, errors[0][0]);
        return;
      }
      summary.classList.add('hidden');
      const data = values();
      composed = composeMessage(data);

      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = 'Sending…';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, website: field('website')?.value || '', page: location.href }),
          signal: AbortSignal.timeout(12_000),
        });
        const result = await response.json().catch(() => ({}));
        if (response.ok && result.ok) {
          form.reset();
          form.classList.add('hidden');
          sent.classList.remove('hidden');
          sent.focus();
          return;
        }
        if (response.status === 400 && result.errors) {
          const names = Object.keys(result.errors);
          names.forEach(name => showError(name, result.errors[name]));
          showSummary('Please fix the highlighted fields.', names[0]);
          return;
        }
        if (response.status === 429) {
          showSummary('You have sent several messages in a short time. Please wait a few minutes, or call us on +92 322 7041953.');
          return;
        }
        openMailApp(data); // not configured (501) or delivery failed
      } catch {
        openMailApp(data); // offline or timed out
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });

    document.getElementById('contact-reset')?.addEventListener('click', () => {
      success.classList.add('hidden');
      form.classList.remove('hidden');
      field('message').focus();
    });
    document.getElementById('contact-copy')?.addEventListener('click', async () => {
      const status = document.getElementById('contact-copy-status');
      try {
        await navigator.clipboard.writeText(composed);
        if (status) status.textContent = 'Message copied. Paste it into an email to info@autodiagnostix.com.pk.';
      } catch {
        if (status) status.textContent = 'Copy is not available in this browser. Please select your message in the form and copy it manually.';
      }
    });
  }
</script>

<style>
  .hp-field { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .primary-gradient { background: linear-gradient(135deg, #97000d 0%, #bb2221 100%); }
  a[href^="mailto:"] { overflow-wrap: anywhere; }
</style>
