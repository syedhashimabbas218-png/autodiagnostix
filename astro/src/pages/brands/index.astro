---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrands, getBrandRecords } from '../../lib/strapi';
import { breadcrumbListSchema } from '../../utils/schema';
import { cardGridCols } from '../../utils/grid.mjs';

export const prerender = false;

// Product-derived brands carry counts and the canonical slugs (e.g.
// /brand/gtitools); CMS brand records add authorized brands that have no
// products assigned yet (SMARTSAFE and AUTOOL were missing from this page).
const [productBrands, brandRecords] = await Promise.all([getBrands(), getBrandRecords()]);
const key = (value: string) => value.toLowerCase().replace(/[^a-z0-9]/g, '');
const brands = [
  ...productBrands,
  ...brandRecords
    .filter(record => !productBrands.some(b => key(b.slug) === key(record.slug) || key(b.name) === key(record.name)))
    .map(record => ({ id: record.slug, slug: record.slug, name: record.name, description: record.description || '', productCount: 0, image: '' })),
];
// Show the manufacturer's logo (shipped in /images/brands) rather than an
// arbitrary product photo; fall back to the product image for new brands.
const BRAND_LOGOS: Record<string, string> = {
  launch: '/images/brands/launch.webp',
  smartsafe: '/images/brands/smartsafe.webp',
  unite: '/images/brands/unite.webp',
  'liberty-lifts': '/images/brands/liberty-lifts.webp',
  gtitools: '/images/brands/gti-tools.webp',
  'gti-tools': '/images/brands/gti-tools.webp',
  autool: '/images/brands/autool.webp',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://autodiagnostix.com.pk/' },
  { name: 'Brands', url: 'https://autodiagnostix.com.pk/brands' },
];
---

<BaseLayout
  title="Brands: LAUNCH, Smartsafe, UNITE, Liberty Lifts, GTI.tools, AUTOOL"
  description="Browse industry-leading diagnostic and workshop equipment manufacturers at Autodiagnostix Pakistan. Authorized dealer for LAUNCH, SMARTSAFE, UNITE, Liberty Lifts, GTI.tools, and AUTOOL."
  canonical="https://autodiagnostix.com.pk/brands"
  jsonLd={breadcrumbListSchema(breadcrumbs)}
>
  <Header ctaLabel="Request a Quote" ctaHref="/contact" />

  <main id="main-content" class="min-h-screen pt-14 md:pt-16">
    <header class="bg-surface pt-6 md:pt-10 pb-8 md:pb-10 px-8 border-b border-outline-variant/10">
      <div class="max-w-screen-2xl mx-auto">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-xs font-label uppercase tracking-widest text-on-surface-variant mb-4">
          <a href="/" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Home</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">Brands</span>
        </nav>
        <h1 class="font-headline text-[clamp(2.5rem,1.6rem+3.2vw,4.5rem)] leading-[1.05] font-extrabold tracking-tighter text-on-surface mb-3">Our Brands</h1>
        <p class="text-on-surface-variant text-lg md:text-xl max-w-xl">Industry-leading manufacturers powering professional workshops worldwide.</p>
      </div>
    </header>

    <section class="py-16 px-8 bg-surface-container-low">
      <div class={`max-w-screen-2xl mx-auto grid grid-cols-1 gap-6 md:gap-8 ${cardGridCols(brands.length)}`}>
        {brands.map(brand => (
          <a href={`/brand/${brand.slug}`} class="group block bg-surface-container-lowest rounded-2xl overflow-hidden hover:shadow-2xl transition-all hover:-translate-y-1">
            <div class="aspect-[16/7] bg-white p-8 flex items-center justify-center overflow-hidden">
              {BRAND_LOGOS[brand.slug] ? (
                <img src={BRAND_LOGOS[brand.slug]} alt={`${brand.name} logo`} class="max-h-16 w-auto max-w-[75%] object-contain group-hover:scale-105 transition-transform" loading="lazy" decoding="async" />
              ) : brand.image ? (
                <img src={brand.image} alt={brand.name} class="max-h-24 max-w-full object-contain group-hover:scale-105 transition-transform mix-blend-multiply" loading="lazy" decoding="async" />
              ) : (
                <div class="text-3xl font-headline font-bold text-slate-300">{brand.name.charAt(0)}</div>
              )}
            </div>
            <div class="p-6 flex items-center justify-between">
              <div>
                <h2 class="font-headline font-extrabold text-xl tracking-tight group-hover:text-primary transition-colors">{brand.name}</h2>
                <p class="text-xs text-on-surface-variant mt-0.5">{brand.productCount > 0 ? `${brand.productCount} product${brand.productCount !== 1 ? 's' : ''}` : 'View brand'}</p>
              </div>
              <span class="text-on-surface-variant group-hover:text-primary group-hover:translate-x-1 transition-all" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
