---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCategory, getProducts, sortByAvailability, cardImage } from '../../lib/strapi';
import { breadcrumbListSchema, itemListSchema } from '../../utils/schema';
import { cardGridCols, excerpt } from '../../utils/grid.mjs';

export const prerender = false;

const { id } = Astro.params;
const [category, allProducts] = await Promise.all([
  getCategory(id!),
  getProducts({ summaryOnly: true }),
]);
const products = sortByAvailability(allProducts);

if (!category) {
  return Astro.rewrite('/404');
}

const filtered = products.filter(p => {
  const catSlug = p.categorySlug || (p.category || '').toLowerCase().replace(/ & /g, '-').replace(/\s+/g, '-');
  return catSlug === id || p.category === id || p.category?.toLowerCase() === id!.replace(/-/g, ' ');
});

const breadcrumbs = [
  { name: 'Home', url: 'https://autodiagnostix.com.pk/' },
  { name: category.name, url: `https://autodiagnostix.com.pk/category/${id}` },
];

---

<BaseLayout
  title={`${category.name} in Pakistan: Products & Equipment`}
  description={`Browse ${filtered.length} professional ${category.name} products in Pakistan at Autodiagnostix. Authorized dealer for Launch, Smartsafe, UNITE, Liberty Lifts, GTI.tools, and AUTOOL. Delivery & installation across Pakistan.`}
  canonical={`https://autodiagnostix.com.pk/category/${id}`}
  jsonLd={[breadcrumbListSchema(breadcrumbs), itemListSchema(filtered.map(p => ({ name: p.name, url: `https://autodiagnostix.com.pk/product/${p.id}` })))]}
>
  <Header ctaLabel="Request a Quote" ctaHref="/contact" />

  <main id="main-content" class="min-h-screen pt-14 md:pt-16">
    <header class="bg-surface pt-6 md:pt-10 pb-8 md:pb-10 px-8 border-b border-outline-variant/10">
      <div class="max-w-screen-2xl mx-auto">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-xs font-label uppercase tracking-widest text-on-surface-variant mb-4">
          <a href="/" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Home</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">{category.name}</span>
        </nav>
        <h1 class="font-headline text-[clamp(2.25rem,1.5rem+2.6vw,3.75rem)] leading-[1.05] font-extrabold tracking-tighter text-on-surface mb-3">{category.name} in Pakistan</h1>
        <p class="text-on-surface-variant text-lg md:text-xl leading-relaxed max-w-3xl">{filtered.length} professional {category.name.toLowerCase()} product{filtered.length !== 1 ? 's' : ''} from Autodiagnostix, Pakistan's authorized dealer for Launch, Smartsafe, UNITE, Liberty Lifts, GTI.tools, and AUTOOL. With delivery, installation and on-site training across Pakistan.</p>
      </div>
    </header>

    <section class="bg-surface-container-low py-14 px-8">
      <div class="max-w-screen-2xl mx-auto">
        {filtered.length === 0 ? (
          <div class="py-24 text-center text-on-surface-variant text-xl">No products in this category.</div>
        ) : (
          <>
            <p class="text-xs text-on-surface-variant font-bold uppercase tracking-widest mb-8">{filtered.length} product{filtered.length !== 1 ? 's' : ''}</p>
            <div class={`grid grid-cols-1 gap-4 md:gap-6 ${cardGridCols(filtered.length)}`}>
              {filtered.map((product, index) => (
                <a href={`/product/${product.id}`} class="group bg-surface-container-lowest rounded-2xl overflow-hidden hover:shadow-2xl transition-all hover:-translate-y-1 flex flex-col">
                  <div class="aspect-[4/3] bg-white p-6 flex items-center justify-center relative overflow-hidden">
                    {product.heroImages[0] ? (
                      <img {...cardImage(product.heroImages[0])} alt={product.name} class="w-full h-full object-contain group-hover:scale-105 transition-transform mix-blend-multiply" loading={index < 4 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" width="800" height="600" />
                    ) : (
                      <div class="text-slate-300 text-sm">No image</div>
                    )}
                    {product.badge && (
                      <div class="absolute top-3 right-3 z-10">
                        <span class={`${product.badge === 'NEW' ? 'bg-green-700' : product.badge === 'DISCONTINUED' ? 'bg-red-700' : 'bg-amber-700'} text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow-sm`}>{product.badge}</span>
                      </div>
                    )}
                  </div>
                  <div class="p-6 flex flex-col flex-grow">
                    <p class="text-[11px] font-bold uppercase tracking-widest text-on-surface-variant mb-1 min-h-[1rem]">{product.brand}</p>
                    <h2 class="font-headline text-lg font-bold tracking-tight mb-2 group-hover:text-primary transition-colors leading-snug">{product.name}</h2>
                    <p class="text-on-surface-variant text-sm leading-relaxed mb-6 flex-grow line-clamp-3">{excerpt(product.summary)}</p>
                    <span class="text-primary font-bold text-sm flex items-center gap-1 mt-auto pt-4 border-t border-outline-variant/10 group-hover:gap-2 transition-all">View Specs &rarr;</span>
                  </div>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
