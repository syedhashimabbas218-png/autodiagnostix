---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductGrid from '../../components/ProductGrid';
import { getProducts, sortByAvailability } from '../../lib/strapi';
import { breadcrumbListSchema, itemListSchema } from '../../utils/schema';

export const prerender = false;

const products = sortByAvailability(await getProducts({ summaryOnly: true }));

const breadcrumbs = [
  { name: 'Home', url: 'https://autodiagnostix.com.pk/' },
  { name: 'Products', url: 'https://autodiagnostix.com.pk/products' },
];
---

<BaseLayout
  title="All Products , Diagnostic Scanners, Lifts, Wheel Alignment & Workshop Equipment | Autodiagnostix"
  description="Browse our complete range of professional automotive diagnostic equipment, car lifts, wheel aligners, tyre changers, ADAS, EV diagnostic tools, battery testers, and videoscopes. Authorized dealer for Launch, Smartsafe, UNITE, Liberty Lifts, GTI.tools, and AUTOOL in Pakistan."
  canonical="https://autodiagnostix.com.pk/products"
  jsonLd={[breadcrumbListSchema(breadcrumbs), itemListSchema(products.map(p => ({ name: p.name, url: `https://autodiagnostix.com.pk/product/${p.id}` })), 'CollectionPage')]}
>
  <Header ctaLabel="Request a Quote" ctaHref="/contact" />

  <main id="main-content" class="min-h-screen pt-14 md:pt-16">
    <header class="bg-surface pt-6 md:pt-10 pb-8 md:pb-10 px-8 border-b border-outline-variant/10">
      <div class="max-w-screen-2xl mx-auto">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-xs font-label uppercase tracking-widest text-on-surface-variant mb-4">
          <a href="/" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Home</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">All Products</span>
        </nav>
        <h1 class="font-headline text-[clamp(2.5rem,1.6rem+3.2vw,4.5rem)] leading-[1.05] font-extrabold tracking-tighter text-on-surface mb-3">All Products</h1>
        <p class="text-on-surface-variant text-lg md:text-xl max-w-xl">{products.length} products</p>
      </div>
    </header>

    <ProductGrid client:load initialSearch={Astro.url.searchParams.get('q') || ''} products={products.map(p => ({
      id: p.id,
      name: p.name,
      brand: p.brand,
      badge: p.badge,
      image: p.heroImages?.[0] || '',
      description: p.summary || '',
    }))} />
  </main>

  <Footer />
</BaseLayout>
