---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getBrands, getBrandDetails, getProducts, sortByAvailability, cardImage } from '../../lib/strapi';
import type { Brand, Product } from '../../lib/strapi';
import { breadcrumbListSchema, brandSchema } from '../../utils/schema';
import { cardGridCols } from '../../utils/grid.mjs';

export const prerender = false;

const { id } = Astro.params;
let brand: Brand | null = null;
let brandList: Awaited<ReturnType<typeof getBrands>> = [];
let brandProducts: Product[] = [];

// Try to find the brand by both the URL slug and any legacy slug
// (e.g. "gtitools" for "GTI.tools"). The new Strapi brands use
// proper slugs (gti-tools), but getBrands() in strapi.ts still derives
// the old product-based slug. Match both.
function findBrand(list: Awaited<ReturnType<typeof getBrands>>, key: string) {
  const normalized = key.toLowerCase();
  return (
    list.find(b => b.slug === key) ||
    list.find(b => b.slug === normalized) ||
    list.find(b => b.name.toLowerCase().replace(/[^a-z0-9]+/g, '') === normalized.replace(/[^a-z0-9]+/g, '')) ||
    list.find(b => b.name.toLowerCase() === normalized)
  );
}

try {
  const all = sortByAvailability(await getProducts({ summaryOnly: true }));
  brandList = await getBrands(all);
  brand = findBrand(brandList, id || '') ?? await getBrandDetails(id || '');
  if (brand) {
    // Match by any of the brand's name forms
    const brandName = brand.name.toLowerCase();
    const brandKey = brand.slug.toLowerCase().replace(/-/g, '');
    brandProducts = all.filter(p => p.brands.some(b => {
      const bn = b.toLowerCase();
      const bk = bn.replace(/[^a-z0-9]+/g, '');
      return bn === brandName || bk === brandKey;
    }));
  }
} catch (error) { throw error; }

if (!brand) return Astro.rewrite('/404');
// Aliases and case variants (e.g. /brand/gti-tools, /brand/Launch) served a
// duplicate of the canonical brand page; consolidate them with a 301.
if (id !== brand.slug) return Astro.redirect(`/brand/${brand.slug}`, 301);

const breadcrumbs = [
  { name: 'Home', url: 'https://autodiagnostix.com.pk/' },
  { name: 'Brands', url: 'https://autodiagnostix.com.pk/brands' },
  { name: brand.name, url: `https://autodiagnostix.com.pk/brand/${brand.slug}` },
];
---

<BaseLayout
  title={`${brand.name} Products in Pakistan: Authorized Dealer`}
  description={`Browse ${brandProducts.length} ${brand.name} products in Pakistan at Autodiagnostix. Authorized ${brand.name} dealer for diagnostic scanners, car lifts, wheel aligners, tyre changers, ADAS, EV tools and workshop equipment. Delivery across Pakistan.`}
  canonical={`https://autodiagnostix.com.pk/brand/${brand.slug}`}
  jsonLd={[breadcrumbListSchema(breadcrumbs), brandSchema({ name: brand.name, url: `https://autodiagnostix.com.pk/brand/${brand.slug}`, description: brand.description, image: brand.image })]}
>
  <Header ctaLabel="Request a Quote" ctaHref="/contact" />

  <main id="main-content" class="min-h-screen pt-14 md:pt-16">
    <header class="bg-surface pt-6 md:pt-10 pb-8 md:pb-10 px-8 border-b border-outline-variant/10">
      <div class="max-w-screen-2xl mx-auto">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 text-xs font-label uppercase tracking-widest text-on-surface-variant mb-4">
          <a href="/" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Home</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <a href="/brands" class="inline-flex items-center min-h-[44px] min-w-[44px] hover:text-primary transition-colors">Brands</a>
          <span class="text-[10px]" aria-hidden="true">/</span>
          <span class="text-primary font-bold" aria-current="page">{brand.name}</span>
        </nav>
        <h1 class="font-headline text-[clamp(2.5rem,1.6rem+3.2vw,4.5rem)] leading-[1.05] font-extrabold tracking-tighter text-on-surface mb-3">{brand.name}</h1>
        {brandProducts.length > 0 && <p class="text-on-surface-variant text-lg md:text-xl max-w-xl">{brandProducts.length} product{brandProducts.length !== 1 ? 's' : ''} from {brand.name}</p>}
        {brand.description && <p class="text-on-surface-variant text-base max-w-2xl mt-3 leading-relaxed">{brand.description}</p>}
      </div>
    </header>

    {brandProducts.length > 0 ? (
      <section class="py-16 px-8 bg-white">
        <div class="max-w-screen-2xl mx-auto">
          <div class={`grid grid-cols-1 gap-4 md:gap-6 ${cardGridCols(brandProducts.length)}`}>
            {brandProducts.map((p, index) => (
              <a href={`/product/${p.id}`} class="group relative bg-surface-container-low overflow-hidden hover:shadow-[0_0_0_1px_rgba(151,0,13,0.15)] transition-all duration-200 ease-out">
                <div class="aspect-[4/3] bg-white flex items-center justify-center overflow-hidden">
                  {p.heroImages && p.heroImages[0] ? (
                    <img {...cardImage(p.heroImages[0])} alt={p.name} class="w-full h-full object-contain p-6 transition-transform duration-200 ease-out group-hover:scale-105" loading={index < 4 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" width="800" height="600" referrerpolicy="no-referrer" />
                  ) : (
                    <div class="text-zinc-300 text-4xl">📦</div>
                  )}
                </div>
                <div class="p-5 bg-white">
                  <div class="flex items-center gap-2 mb-2">
                    {p.brands[0] && (
                      <span class="text-[11px] font-bold uppercase text-primary tracking-widest">{p.brands[0]}</span>
                    )}
                    <div class="h-px flex-1 bg-zinc-100"></div>
                  </div>
                  <h2 class="text-base font-headline font-extrabold mb-1 group-hover:text-primary transition-colors line-clamp-1">{p.name}</h2>
                  <p class="text-zinc-500 text-xs leading-relaxed line-clamp-2">{p.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ) : (
      <section class="py-16 px-8 bg-surface-container-low text-center">
        <p class="text-on-surface-variant text-lg max-w-2xl mx-auto">No products available right now. Explore our complete range of {brand.name} products on the main catalog.</p>
        <a href="/products" class="inline-flex items-center min-h-[48px] mt-6 bg-primary text-white px-8 text-sm font-headline font-medium hover:brightness-110 transition-all">Browse All Products</a>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>
