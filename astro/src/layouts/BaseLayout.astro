---
import '../styles/global.css';
import { SITE_URL, canonicalUrl, normalizeSiteUrls } from '../utils/site.mjs';
import { CMS_URL } from '../lib/strapi';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  omitCanonical?: boolean;
  datePublished?: string;
  dateModified?: string;
  author?: string;
}

const SITE_NAME = 'Autodiagnostix';
// Product photos are served from the public CMS origin; open that connection
// early so the first product image (often the LCP) is not delayed by it.
const CMS_MEDIA_ORIGIN = (() => {
  try {
    const url = new URL(CMS_URL);
    return url.protocol === 'https:' ? url.origin : '';
  } catch { return ''; }
})();
// Raster default: Facebook, LinkedIn and WhatsApp do not render SVG previews.
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.png`;
const PUBLISHER_NAME = 'Autodiagnostix';

const {
  title,
  description = 'Pakistan\'s authorized dealer for LAUNCH, SMARTSAFE, UNITE, GTI.tools, Liberty Lifts and AUTOOL. Buy car lifts, 3D wheel aligners, ADAS, EV diagnostics, tyre changers and videoscopes. Delivery across Pakistan.',
  canonical,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  ogImageWidth = '1200',
  ogImageHeight = '630',
  ogImageAlt = 'Autodiagnostix, Pakistan\'s authorized dealer for LAUNCH, Smartsafe, UNITE, GTI.tools, Liberty Lifts and AUTOOL',
  jsonLd,
  noindex,
  omitCanonical = false,
  datePublished,
  dateModified,
  author = PUBLISHER_NAME,
} = Astro.props;

// Don't append SITE_NAME if the title already ends with it (avoids "Foo | Bar | Bar" duplication).
const cleanTitle = (title || '').trim();
const siteNameLower = SITE_NAME.toLowerCase();
const cleanTitleLower = cleanTitle.toLowerCase();
const titleAlreadyHasSite = cleanTitleLower === siteNameLower || cleanTitleLower.endsWith(` | ${siteNameLower}`);
const fullTitle = title ? (titleAlreadyHasSite ? title : `${title} | ${SITE_NAME}`) : `Autodiagnostix | Launch, Smartsafe, UNITE Dealer in Pakistan`;
const pageCanonical = canonicalUrl(canonical || Astro.url.pathname);
const socialImage = normalizeSiteUrls(new URL(ogImage, `${SITE_URL}/`).href);
const structuredData = normalizeSiteUrls(jsonLd);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=ax-20261103" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=ax-20261103" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    {CMS_MEDIA_ORIGIN && <link rel="preconnect" href={CMS_MEDIA_ORIGIN} />}
    {CMS_MEDIA_ORIGIN && <link rel="dns-prefetch" href={CMS_MEDIA_ORIGIN} />}
    <!-- Self-hosted fonts (see global.css): preload the latin faces used above the fold. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={pageCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_PK" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Only actual editorial pages receive article metadata and supplied dates. -->
    <meta name="author" content={author} />
    {ogType === 'article' && <meta property="article:author" content={author} />}
    {ogType === 'article' && <meta property="article:publisher" content={`${SITE_URL}/`} />}
    {ogType === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
    {ogType === 'article' && dateModified && <meta property="article:modified_time" content={dateModified} />}
    <meta name="geo.region" content="PK-PB" />
    <meta name="geo.placename" content="Sahiwal, Pakistan" />
    <meta name="geo.position" content="30.6644;73.1085" />
    <meta name="ICBM" content="30.6644, 73.1085" />

    {!noindex && !omitCanonical && <link rel="canonical" href={pageCanonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {structuredData && (
      Array.isArray(structuredData) ? structuredData.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
      )) : (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
      )
    )}

    <title>{fullTitle}</title>
  </head>
  <body class="bg-surface text-on-surface min-h-screen">
    <slot />
  </body>
</html>
