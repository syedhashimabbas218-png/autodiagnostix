# URL of the Strapi CMS API (used by Astro SSR to fetch products, categories, etc.)
# All Strapi API calls happen server-side — no browser code calls Strapi directly.
# - Same Coolify project with Docker network: use http://strapi:1337
# - Separate Coolify resources or external: use the public URL (e.g. https://cms.yourdomain.com)
PUBLIC_STRAPI_URL=http://localhost:1337

# Production canonical hostname is fixed in src/utils/site.mjs to match redirects.
# The sitemap is generated at runtime using the same CMS URL as the catalog.

# Optional: deliver contact-form enquiries server-side. Any URL that accepts a
# JSON POST works (Zapier/Make/n8n webhook, Google Apps Script web app that
# emails the team, Slack workflow, CRM). Payload fields: name, email, phone,
# subject, subjectLabel, message, text (pre-formatted), page, receivedAt.
# Leave empty to keep the fallback: the form opens the visitor's email app
# addressed to info@/sales@.
CONTACT_WEBHOOK_URL=

# Optional: seconds to reuse CMS responses before revalidating (default 60).
# Set to 0 to always read Strapi live.
CMS_CACHE_SECONDS=60
